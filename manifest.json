{
    "manifest_version": 3,
    "name": "Zen Mode Grokipedia",
    "icons": {
        "16": "zen16.png",
        "48": "zen48.png",
        "128": "zen128.png"
    },
    "version": "1.2",
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "zen16.png",
            "48": "zen48.png",
            "128": "zen128.png"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.grokipedia.com/*"
            ],
            "js": [
                "content.js"
            ]
        }
    ]
}